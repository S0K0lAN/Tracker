{
  "name": "focus-flow-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "check:full": "npm run check && npm run test:e2e",
    "tauri": "tauri",
    "android:env": "bash scripts/mobile-env.sh",
    "android:build": "bash scripts/android-build.sh",
    "android:verify": "bash scripts/android-verify.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.55.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
